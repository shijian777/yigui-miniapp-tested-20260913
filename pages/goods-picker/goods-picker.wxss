/* pages/goods-picker/goods-picker.wxss */
.search-box { display: flex; align-items: center; padding: 0 24rpx; height: 84rpx; margin-top: 20rpx; }
.search-icon { margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.ph { color: #bbb; }
.search-clear { color: #bbb; padding: 0 8rpx; }
.pick-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.pick-row:last-child { border-bottom: none; }
.pick-stock { color: #999; font-size: 24rpx; }
.pick-btn {
  margin-top: 10rpx; text-align: center; color: #07c160; border: 1rpx solid #07c160;
  border-radius: 8rpx; font-size: 24rpx; padding: 6rpx 28rpx;
}
.empty-mini { padding: 60rpx 24rpx; }
.empty-txt { text-align: center; color: #999; }
.badge {
  display: inline-block; margin-left: 10rpx; padding: 2rpx 10rpx;
  border-radius: 8rpx; font-size: 20rpx; font-weight: 500;
}
.badge-on { background: #e8f8ee; color: #07c160; }
.mt10 { margin-top: 10rpx; }
