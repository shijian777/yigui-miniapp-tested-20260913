/* pages/sale/sale.wxss */
.search-wrap { padding: 20rpx 20rpx 0; position: sticky; top: 0; z-index: 30; background: #f5f6f8; }
.search-box {
  display: flex; align-items: center; background: #fff; border-radius: 16rpx;
  padding: 0 24rpx; height: 88rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.search-icon { margin-right: 12rpx; font-size: 28rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.ph { color: #bbb; }
.search-clear { color: #bbb; padding: 0 8rpx; }
.drop { margin-top: 12rpx; max-height: 560rpx; overflow-y: auto; }
.drop-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.drop-item:last-child { border-bottom: none; }
.price { color: #e64340; font-weight: 600; }

.empty-mini { padding: 40rpx 24rpx; }
.empty-txt { text-align: center; color: #999; }

.cart-item { padding: 24rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.cart-item:last-child { border-bottom: none; }
.cart-name { font-size: 30rpx; font-weight: 600; }
.sku-tag {
  display: inline-block; margin-left: 10rpx; padding: 2rpx 12rpx;
  background: #e8f8ee; color: #07c160; border-radius: 8rpx;
  font-size: 22rpx; font-weight: 500;
}
.cart-del { color: #e64340; font-size: 24rpx; padding: 4rpx 8rpx; }
.cart-line { margin-top: 16rpx; }
.cart-qty { display: flex; align-items: center; }
.step-btn {
  width: 60rpx; height: 60rpx; line-height: 58rpx; text-align: center; font-size: 36rpx;
  background: #f2f3f5; border-radius: 12rpx; color: #333;
}
.qty-input {
  width: 100rpx; height: 60rpx; text-align: center; font-size: 30rpx; margin: 0 8rpx;
  background: #fff; border: 1rpx solid #eee; border-radius: 12rpx;
}
.cart-price-line { display: flex; align-items: center; }
.money-input {
  width: 150rpx; height: 56rpx; font-size: 30rpx; text-align: right;
  border-bottom: 1rpx dashed #ccc; margin: 0 8rpx;
}
.cart-amount { font-weight: 700; color: #e64340; min-width: 120rpx; text-align: right; }

.form-value.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 8rpx 22rpx; background: #f2f3f5; border-radius: 24rpx; font-size: 24rpx;
  color: #333; margin: 6rpx 10rpx 6rpx 0;
}
.chip-on { background: #07c160; color: #fff; }
.chip.red { color: #e64340; }
.pct-input {
  width: 120rpx; height: 60rpx; background: #f7f8fa; border-radius: 12rpx;
  text-align: center; font-size: 28rpx; margin-right: 10rpx;
}
.total-block { margin: 10rpx 0; padding: 20rpx 0; border-top: 1rpx dashed #eee; }
.total-row { padding: 8rpx 0; }
.total-row.due { border-top: 1rpx dashed #eee; margin-top: 10rpx; padding-top: 20rpx; }
.due-label { font-size: 32rpx; font-weight: 600; }
.due-num { font-size: 48rpx; font-weight: 700; color: #e64340; }
.rmb { margin-right: 6rpx; }
.pay-chips .chip { padding: 12rpx 28rpx; }

.foot-total { margin-right: 24rpx; text-align: right; }
.foot-num { font-size: 40rpx; font-weight: 700; color: #e64340; }
.submit-btn { flex: 1; }
