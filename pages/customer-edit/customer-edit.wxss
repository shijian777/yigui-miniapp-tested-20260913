/* pages/customer-edit/customer-edit.wxss */
.page { padding: 20rpx; padding-bottom: 140rpx; }
.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}
.form-item {
  display: flex; align-items: center; padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-label { width: 140rpx; font-size: 28rpx; color: #555; }
.required { color: #e64340; margin-left: 6rpx; }
.input { flex: 1; font-size: 28rpx; }
.textarea {
  flex: 1; height: 140rpx; font-size: 28rpx;
  padding: 8rpx 0; box-sizing: border-box;
}

/* 标签 */
.tags-area {
  display: flex; flex-wrap: wrap; gap: 12rpx;
}
.tag {
  display: inline-block; padding: 8rpx 18rpx;
  background: #f2f3f5; color: #555; border-radius: 24rpx;
  font-size: 24rpx;
}
.tag-on { background: #07c160; color: #fff; }
.tag-suggest { background: #fff; border: 1rpx dashed #ccc; color: #888; }
.row { display: flex; align-items: center; }
.mt10 { margin-top: 10rpx; }
.tag-input {
  flex: 1; height: 56rpx; padding: 0 12rpx; font-size: 26rpx;
  background: #f7f8fa; border-radius: 8rpx;
}
.btn-mini {
  margin-left: 12rpx; padding: 8rpx 18rpx; background: #07c160;
  color: #fff; border-radius: 8rpx; font-size: 24rpx;
}

.page-footer-space { height: 120rpx; }
.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; padding: 16rpx 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.submit-btn { width: 100%; }
.btn {
  font-size: 30rpx; border-radius: 12rpx; padding: 0;
}
.btn::after { border: none; }
.btn-primary { background: #07c160; color: #fff; }
