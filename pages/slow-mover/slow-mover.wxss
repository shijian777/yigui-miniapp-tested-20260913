/* pages/slow-mover/slow-mover.wxss */
.page { padding: 20rpx; padding-bottom: 60rpx; }
.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}
.section-title-inline { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #333; padding: 0 8rpx; margin-bottom: 12rpx; }
.muted { color: #888; }
.small { font-size: 24rpx; }
.mt10 { margin-top: 14rpx; }
.quick { display: flex; gap: 12rpx; flex-wrap: wrap; }
.chip {
  padding: 10rpx 24rpx; background: #f2f3f5; border-radius: 24rpx;
  font-size: 26rpx; color: #555;
}
.chip-on { background: #07c160; color: #fff; font-weight: 600; }

.summary-grid { display: flex; gap: 20rpx; }
.cell { flex: 1; padding: 12rpx 0; }
.big-num { font-size: 44rpx; font-weight: 800; line-height: 1.3; }
.red { color: #e64340; }
.green { color: #07c160; }
.strong { font-weight: 600; }

.slow-row { padding: 22rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.slow-row:last-child { border-bottom: none; }
.row-title { font-size: 30rpx; font-weight: 600; }
.sku-tag {
  display: inline-block; margin-left: 10rpx; padding: 2rpx 10rpx;
  background: #e8f8ee; color: #07c160; border-radius: 8rpx;
  font-size: 22rpx; font-weight: 500;
}
.right { text-align: right; }
.slow-qty { font-size: 26rpx; color: #555; }

.slow-actions { margin-top: 12rpx; display: flex; gap: 12rpx; }
.action {
  padding: 8rpx 18rpx; border: 1rpx solid #ddd; border-radius: 8rpx;
  font-size: 24rpx; color: #555;
}
.action-primary { border-color: #07c160; color: #07c160; font-weight: 600; }

.empty-mini { padding: 60rpx 24rpx; }
.empty-txt { text-align: center; color: #999; }
.between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
