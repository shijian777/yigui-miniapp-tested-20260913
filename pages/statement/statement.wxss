/* pages/statement/statement.wxss */
.page { padding: 20rpx; padding-bottom: 60rpx; }
.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}
.section-title { font-size: 28rpx; font-weight: 600; padding: 0 8rpx; margin-bottom: 12rpx; color: #333; }
.section-title-inline { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; color: #333; }
.muted { color: #888; }
.small { font-size: 24rpx; }
.mt10 { margin-top: 14rpx; }
.between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.row-title { font-size: 30rpx; font-weight: 600; }

.chip {
  padding: 8rpx 22rpx; background: #f2f3f5; border-radius: 24rpx;
  font-size: 24rpx; color: #555;
}
.chip-on { background: #07c160; color: #fff; font-weight: 600; }
.quick { display: flex; gap: 12rpx; flex-wrap: wrap; }
.btn-mini {
  margin-left: 12rpx; padding: 8rpx 18rpx; background: #07c160;
  color: #fff; border-radius: 8rpx; font-size: 24rpx;
}

.sum-row { display: flex; justify-content: space-between; padding: 6rpx 0; font-size: 28rpx; }
.strong { font-weight: 600; }
.red { color: #e64340; }
.green { color: #07c160; }

.stmt-row { padding: 22rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.stmt-row:last-child { border-bottom: none; }
.right { text-align: right; }
.badge {
  display: inline-block; margin-left: 10rpx; padding: 2rpx 10rpx;
  border-radius: 8rpx; font-size: 22rpx; font-weight: 500;
}
.badge-red { background: #fdecea; color: #e64340; }

.empty-mini { padding: 60rpx 24rpx; }
.empty-txt { text-align: center; color: #999; }
