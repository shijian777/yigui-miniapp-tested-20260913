.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 10rpx 28rpx; background: #e9eaec; border-radius: 8rpx; font-size: 26rpx;
  color: #555; margin: 6rpx 14rpx 6rpx 0;
