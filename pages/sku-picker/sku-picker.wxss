/* pages/sku-picker/sku-picker.wxss */
.page { padding: 20rpx; padding-bottom: 140rpx; }
.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}
.hd { margin-bottom: 10rpx; }
.name { font-size: 32rpx; font-weight: 700; color: #222; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; color: #333; }
.between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.row-title { font-size: 30rpx; font-weight: 600; color: #222; }
.muted { color: #888; }
.small { font-size: 24rpx; }
.mt20 { margin-top: 20rpx; }

/* ========== 矩阵 ========== */
.matrix {
  border: 1rpx solid #eee; border-radius: 12rpx; overflow: hidden;
}
.matrix-head {
  display: flex; align-items: center; padding: 12rpx 8rpx;
  background: #fafafa; border-bottom: 1rpx solid #eee;
}
.matrix-corner { width: 90rpx; padding-left: 8rpx; font-size: 22rpx; }
.matrix-col-head {
  flex: 1; min-width: 0; text-align: center; font-size: 26rpx;
  color: #555; font-weight: 600;
}
.matrix-row {
  display: flex; align-items: stretch; border-bottom: 1rpx solid #f5f5f5;
}
.matrix-row:last-child { border-bottom: none; }
.matrix-row-head {
  width: 90rpx; padding: 12rpx 8rpx; font-size: 26rpx;
  background: #fafafa; color: #333; font-weight: 600;
  border-right: 1rpx solid #eee; display: flex; align-items: center;
}
.cell {
  flex: 1; min-width: 0; padding: 16rpx 4rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-right: 1rpx solid #f5f5f5; transition: all 0.15s;
}
.cell:last-child { border-right: none; }
.cell-stock { font-size: 28rpx; font-weight: 600; color: #222; }
.cell-key { font-size: 18rpx; color: #aaa; margin-top: 2rpx; }
.cell-on { background: #e8f8ee; }
.cell-on .cell-stock { color: #07c160; }
.cell-out { background: #f8f8f8; opacity: 0.55; }
.cell-out .cell-stock { color: #bbb; }

/* ========== 图例 ========== */
.legend { margin-top: 16rpx; display: flex; align-items: center; gap: 24rpx; }
.legend-dot {
  display: inline-block; width: 16rpx; height: 16rpx; border-radius: 50%;
  margin-right: 6rpx; vertical-align: middle;
}
.dot-on { background: #07c160; }
.dot-out { background: #ddd; }

/* ========== 数量 ========== */
.qty-control { display: flex; align-items: center; }
.step {
  width: 56rpx; height: 56rpx; line-height: 54rpx; text-align: center;
  background: #f2f3f5; border-radius: 8rpx; color: #333; font-size: 36rpx;
}
.qty-input {
  width: 96rpx; height: 56rpx; text-align: center; font-size: 30rpx;
  margin: 0 8rpx; border: 1rpx solid #eee; border-radius: 8rpx;
}

/* ========== 进价 ========== */
.cost-edit { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; }
.cost-input {
  flex: 1; height: 60rpx; padding: 0 12rpx; font-size: 28rpx;
  border-bottom: 1rpx dashed #ccc; text-align: right;
}

/* ========== 底部 ========== */
.page-footer-space { height: 120rpx; }
.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; padding: 16rpx 20rpx;
  display: flex; align-items: center; gap: 12rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.submit-btn { flex: 1; }
.btn { font-size: 30rpx; border-radius: 12rpx; padding: 0; }
.btn::after { border: none; }
.btn-primary { background: #07c160; color: #fff; }
.btn-primary[disabled] { background: #c8e6c9; color: #fff; }
