/* pages/goods-edit/goods-edit.wxss */
.stock-num {
  font-size: 32rpx; font-weight: 700;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}
.chips { display: flex; }
.chip {
  padding: 10rpx 32rpx; background: #e9eaec; border-radius: 8rpx; font-size: 26rpx;
  color: #555; margin-right: 16rpx;
}
.chip-on { background: #07c160; color: #fff; }
.chip-off { background: #fdecec; color: #e64340; }
.del-btn { flex: 0 0 180rpx; margin-right: 16rpx; }
.save-btn { flex: 1; }
.form-tip { font-size: 22rpx; color: #bbb; margin-top: 6rpx; }

.card-title { font-size: 28rpx; font-weight: 600; color: #333; padding: 24rpx 28rpx 0; }

/* 扫码按钮（条码 input 旁） */
.scan-row { gap: 16rpx; align-items: center; }
.btn-scan {
  flex-shrink: 0;
  display: flex; align-items: center; gap: 8rpx;
  height: 64rpx; padding: 0 22rpx;
  border-radius: var(--r-sm);
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  color: #fff;
  font-size: 26rpx; font-weight: 600; letter-spacing: 1rpx;
  box-shadow: 0 4rpx 14rpx rgba(99, 102, 241, 0.35);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.btn-scan .ico { display: block; }
.btn-scan-active { transform: scale(0.96); box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.25); }

/* 颜色/尺码 tag */
.tag-list { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; padding: 8rpx 0; }
.tag {
  display: inline-block; padding: 8rpx 24rpx; border-radius: 8rpx; font-size: 26rpx;
}
.tag-blue { background: #e6f3ff; color: #1976d2; }
.tag-input-row { display: flex; align-items: center; gap: 12rpx; }

/* SKU 列表 */
.sku-row {
  display: flex; align-items: center; padding: 16rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.sku-row:last-child { border-bottom: none; }
.sku-label {
  width: 140rpx; font-size: 26rpx; font-weight: 600; color: #1976d2;
  flex-shrink: 0;
}
.sku-fields { flex: 1; display: flex; gap: 12rpx; }
.sku-field { flex: 1; }
.f-label { font-size: 20rpx; color: #999; display: block; margin-bottom: 4rpx; }
.f-input {
  width: 100%; padding: 6rpx 12rpx; background: #f7f7f7; border-radius: 6rpx;
  font-size: 26rpx; box-sizing: border-box;
}
.f-input[disabled] { color: #aaa; background: #fafafa; }

.btn-mini {
  padding: 10rpx 20rpx; background: #07c160; color: #fff; border-radius: 8rpx;
  font-size: 24rpx;
}

.empty-mini { padding: 40rpx 24rpx; }
.empty-txt { text-align: center; color: #999; }