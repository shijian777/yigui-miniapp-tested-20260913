/* pages/purchase/purchase.wxss */
.sup-selected { color: #07c160; font-weight: 600; }
.sup-arrow { font-size: 22rpx; margin-left: 8rpx; }
.sup-panel { margin-top: 16rpx; border-top: 1rpx solid #f2f2f2; padding-top: 8rpx; max-height: 420rpx; overflow-y: auto; }
.sup-opt {
  display: flex; align-items: center; padding: 18rpx 12rpx; border-radius: 10rpx;
  font-size: 28rpx; border-bottom: 1rpx solid #f8f8f8;
}
.sup-opt:last-child { border-bottom: none; }
.opt-on { color: #07c160; font-weight: 600; background: #f0fbf5; }

.pur-line { padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.pur-line:last-child { border-bottom: none; }
.pur-name { font-size: 30rpx; font-weight: 600; }
.pur-amount { font-weight: 700; color: #e64340; }
.pur-del { color: #e64340; font-size: 24rpx; padding: 4rpx 8rpx; }
.sku-tag {
  display: inline-block; padding: 2rpx 10rpx;
  background: #e8f8ee; color: #07c160; border-radius: 8rpx;
  font-size: 22rpx; font-weight: 500;
}
.mt10 { margin-top: 10rpx; }
.mt20 { margin-top: 20rpx; }
.cart-qty { display: flex; align-items: center; }
.step-btn {
  width: 56rpx; height: 56rpx; line-height: 54rpx; text-align: center; font-size: 36rpx;
  background: #f2f3f5; border-radius: 8rpx; color: #333;
}
.qty-input {
  width: 96rpx; height: 56rpx; text-align: center; font-size: 30rpx; margin: 0 8rpx;
  border: 1rpx solid #eee; border-radius: 8rpx;
}
.cost-line { display: flex; align-items: center; }
.money-input {
  width: 150rpx; height: 56rpx; font-size: 30rpx; text-align: right;
  border-bottom: 1rpx dashed #ccc;
}
.add-goods-btn { display: block; margin: 20rpx 20rpx 0; }

.empty-mini { padding: 60rpx 24rpx; }
.empty-txt { text-align: center; color: #999; }
.foot-total { margin-right: 24rpx; text-align: right; }
.foot-num { font-size: 40rpx; font-weight: 700; color: #e64340; }
.submit-btn { flex: 1; }
