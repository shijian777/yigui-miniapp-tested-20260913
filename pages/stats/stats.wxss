/* pages/stats/stats.wxss */
.quick-chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 8rpx 22rpx; background: #f2f3f5; border-radius: 24rpx; font-size: 24rpx;
  color: #333; margin: 6rpx 12rpx 6rpx 0;
}
.chip-on { background: #07c160; color: #fff; }
.date-row { display: flex; align-items: center; margin-top: 16rpx; }
.date-box {
  background: #f7f8fa; border-radius: 8rpx; padding: 10rpx 20rpx;
  font-size: 26rpx; margin: 0 10rpx; min-width: 180rpx; text-align: center;
}
.stat-hero { background: #07c160; color: #fff; text-align: center; padding: 30rpx 24rpx; }
.hero-label { font-size: 26rpx; opacity: 0.9; }
.hero-num { font-size: 64rpx; font-weight: 700; margin: 10rpx 0; }
.hero-sub { font-size: 22rpx; opacity: 0.8; }

.stat-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 20rpx; }
.cell { width: 48%; margin: 20rpx 0 0; box-sizing: border-box; }
/* 大屏不做特殊适配，保持移动端优先（WXSS 不允许空的 @media 块） */
.cell-label { font-size: 24rpx; color: #999; }
.cell-num { font-size: 40rpx; font-weight: 700; margin-top: 6rpx; color: #222; }
.cell-num.green { color: #07c160; }
.cell-num.red { color: #e64340; }
.cell-unit { font-size: 22rpx; color: #999; font-weight: 400; margin-left: 4rpx; }

.top-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.top-row:last-child { border-bottom: none; }
.rank {
  width: 44rpx; height: 44rpx; border-radius: 50%; background: #eee; color: #888;
  text-align: center; line-height: 44rpx; font-size: 24rpx; margin-right: 16rpx;
}
.rank-hot { background: #ff9900; color: #fff; }
.top-name { font-size: 28rpx; }
.top-amount { font-weight: 700; }
.empty-mini { padding: 60rpx 24rpx; }
.empty-txt { text-align: center; color: #999; }
